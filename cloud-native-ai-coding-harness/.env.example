# ====================================================================
# Cloud-Native AI Coding Harness - Environment Configuration
# ====================================================================

# Port & Server settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Sandbox Pool Concurrency & Pre-Warming Parameters
WARM_SANDBOX_TARGET=5
MAX_CONCURRENT_AGENTS=120
SANDBOX_TIMEOUT_SECONDS=60

# Optional LLM API Keys (If using cloud LLM providers; harness has built-in offline solvers for benchmarks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
