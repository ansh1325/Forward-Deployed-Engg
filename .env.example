# ====================================================================
# Enterprise Cold-Chain Logistics AI Assistant - Environment Config
# ====================================================================

# --------------------------------------------------------------------
# 1. Database Configuration (MSSQL Server / Docker / EC2)
# --------------------------------------------------------------------
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433

# Admin credentials (used during Phase 0 legacy data setup)
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=FdeEnterprisePass123!

# Agent Service Account (Least-Privilege Read-Only RBAC user)
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=AgentPassword2026!

# --------------------------------------------------------------------
# 2. Vector Database (Pinecone)
# --------------------------------------------------------------------
# Get your free key at https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# --------------------------------------------------------------------
# 3. Embeddings Engine Configuration
# --------------------------------------------------------------------
# Options: "LOCAL" (uses Hugging Face CPU model - 100% free) or "OPENAI"
Embeddings_model=LOCAL

# If using LOCAL, specify the Hugging Face model identifier (e.g., BAAI/bge-m3)
Local_Embedding_Model=BAAI/bge-m3

# --------------------------------------------------------------------
# 4. LLM Reasoner Configuration
# --------------------------------------------------------------------
# Options: "DEEPSEEK", "OPENAI", or "OLLAMA" (Local fallback)
Agent_llm=DEEPSEEK

# Provider API Keys (Set the one matching your Agent_llm choice)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --------------------------------------------------------------------
# 5. Optional / Observability Settings
# --------------------------------------------------------------------
# Optional fallback mode for quick demo without live MSSQL instance
# USE_SQLITE_MOCK=false
